NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public widget key only. Enable Turnstile in Supabase NEXO Auth and store its secret there.
# Never put the Turnstile secret in NEXT_PUBLIC or only validate the widget in the browser.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server-only, optional until AI is enabled
GROQ_API_KEY=
# Server-only key, needed for atomic AI reservation/finalization (never NEXT_PUBLIC)
SUPABASE_SECRET_KEY=
# Billing stays unavailable until a provider is configured
BILLING_WEBHOOK_SECRET=
BILLING_PROVIDER=disabled
