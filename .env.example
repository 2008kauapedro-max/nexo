NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public widget key only. Enable Turnstile in Supabase NEXO Auth and store its secret there.
# Never put the Turnstile secret in NEXT_PUBLIC or only validate the widget in the browser.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server-only, optional until AI is enabled
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Optional independent fallback; configure all three together
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
# Server-only key, needed only for AI usage finalization (never NEXT_PUBLIC)
SUPABASE_SECRET_KEY=
# Billing stays unavailable until a provider is configured
BILLING_WEBHOOK_SECRET=
BILLING_PROVIDER=disabled
